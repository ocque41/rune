# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for encrypting BYOK secrets stored in Supabase.
# Use a long random value and do not commit the real value.
RUNE_SECRETS_ENCRYPTION_KEY=

# Secret storage provider: supabase, env, aws, or vault.
SECRETS_PROVIDER=supabase

# Optional self-host env-provider examples.
# These are read as secret names OPENAI_API_KEY / GOOGLE_API_KEY / ANTHROPIC_API_KEY.
# WORKFLOW_SECRET_OPENAI_API_KEY=
# WORKFLOW_SECRET_GOOGLE_API_KEY=
# WORKFLOW_SECRET_ANTHROPIC_API_KEY=

# Optional runtime settings
RUNE_WORKFLOW_MODE=sandbox
RUNE_CRON_SECRET=
RUNE_INTERNAL_API_TOKEN=
CUSTOM_CODE_EXEC_SERVICE_URL=

# Optional email providers
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
